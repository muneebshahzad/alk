# Daraz Open Platform seller integration
DARAZ_API_URL=https://api.daraz.pk/rest
DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# The public Al Karamat dashboard URL; used to build /daraz OAuth callback.
APP_BASE_URL=https://dashboard.alkaramat.com
DARAZ_CALLBACK_URL=https://dashboard.alkaramat.com/daraz

# Optional token bootstrap. OAuth tokens are stored in the application database.
DARAZ_ACCESS_TOKEN=
DARAZ_REFRESH_TOKEN=
DARAZ_TOKEN_EXPIRES_AT=

# Optional order-feed controls
DARAZ_ORDER_STATUSES=shipped,pending,ready_to_ship,packed
DARAZ_ORDER_LOOKBACK_DAYS=365
DARAZ_PAGE_LIMIT=50
DARAZ_MAX_PAGES_PER_STATUS=1
DIGIDOKAAN_API_URL=https://digidokaan.pk
DIGIDOKAAN_PHONE=
DIGIDOKAAN_PASSWORD=
DIGIDOKAAN_GATEWAY_ID=5

# Include open, delivered, and archived Shopify orders created within this window.
SHOPIFY_ORDER_LOOKBACK_DAYS=30
